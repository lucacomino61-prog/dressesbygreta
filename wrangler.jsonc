{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Local development runs against simulated D1 and R2 (.wrangler/state).
  // Before a first deploy: `wrangler d1 create greta`, paste the real id below, enable R2 in the dashboard.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greta",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "greta-images" }],
  // Releases stock held by card orders that were never paid.
  "triggers": { "crons": ["*/15 * * * *"] },
  "workers_dev": true,
  "preview_urls": false
}
